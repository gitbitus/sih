# ============================================================
# Merchant Instrument Verification & Certification System
# Environment Variables — copy to .env and fill in values
# ============================================================

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mivc_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mivc_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Auth
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Head Admin Seed Credentials (used by db/seed.ts)
HEAD_ADMIN_EMAIL=headadmin@mivc.gov.in
HEAD_ADMIN_PASSWORD=ChangeMe@123_Replace_In_Production

# File Storage
# STORAGE_DRIVER options: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3-Compatible Storage (only required if STORAGE_DRIVER=s3)
S3_BUCKET=mivc-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT=                        # Optional: for non-AWS S3-compatible services

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                   # true for port 465
SMTP_USER=notifications@mivc.gov.in
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_ADDRESS=MIVC System <notifications@mivc.gov.in>

# SMS (optional — leave blank to disable SMS)
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=MIVC

# QR / Certificate
# Full public URL used in QR codes: https://yourdomain.com/verify/:id
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify
# How many days a certificate is valid
CERTIFICATE_VALIDITY_DAYS=365

# Scheduling
# Maximum number of inspection visits per sub-admin per day
MAX_VISITS_PER_DAY=3
# Rolling window (days) shown in the availability calendar
CALENDAR_WINDOW_DAYS=14

# Rate Limiting (for public endpoints)
RATE_LIMIT_WINDOW_MS=900000         # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
